# Copy to server/.env for local development. All values are optional locally.

# Required in production: a long random string used to sign login sessions.
JWT_SECRET=change-me-to-a-long-random-string

# The admin account is created on first start. Required in production.
ADMIN_EMAIL=admin@shopverse.dev
ADMIN_PASSWORD=Admin@12345

# Card payments (optional). Use test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (optional; payment status is also checked when the shopper returns).
STRIPE_WEBHOOK_SECRET=

# Public URL of the site, used for Stripe redirects. Locally the Vite dev server runs on 5173.
PUBLIC_URL=http://localhost:5173

# Dollar-to-rupee rate used when the catalogue is loaded (run `npm run seed` after changing it).
# USD_TO_INR=85

# Where the SQLite database lives. Point at a persistent disk in production.
# DB_PATH=/var/data/shopverse.db
# PORT=4000
